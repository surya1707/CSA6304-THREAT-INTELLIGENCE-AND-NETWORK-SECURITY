def identify_application(scenario):
    scenario = scenario.lower()

    applications = {
        "Banking Fraud Prevention": [
            "bank", "credit card", "transaction",
            "fraud", "payment", "atm"
        ],
        "Healthcare Data Protection": [
            "hospital", "healthcare", "patient",
            "medical", "health record", "ehr"
        ],
        "E-Commerce Fraud Prevention": [
            "e-commerce", "online shopping",
            "online store", "retailer", "checkout"
        ],
        "Cloud Security": [
            "cloud", "cloud storage", "saas",
            "virtual machine"
        ],
        "Telecommunication Security": [
            "telecom", "mobile network",
            "subscriber", "5g", "4g"
        ]
    }

    scores = {}

    for area, keywords in applications.items():
        score = 0

        for word in keywords:
            if word in scenario:
                score += 1

        scores[area] = score

    best = max(scores, key=scores.get)

    if scores[best] == 0:
        return "No application area identified."

    return best


scenario = input("Enter business scenario: ")
result = identify_application(scenario)

print("Relevant Application:", result)
