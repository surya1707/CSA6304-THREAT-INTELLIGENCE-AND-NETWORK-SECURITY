import json
from collections import Counter

# Sample raw logs
raw_logs = [
    "2026-10-09 10:00:00 INFO User login successful",
    "2026-10-09 10:01:00 ERROR Database connection failed",
    "2026-10-09 10:02:00 WARNING Multiple login attempts",
    "2026-10-09 10:03:00 INFO File uploaded successfully",
    "2026-10-09 10:04:00 ERROR Server timeout"
]

# Logstash-style parsing
events = []

for line in raw_logs:
    parts = line.split(" ", 3)

    if len(parts) == 4:
        event = {
            "date": parts[0],
            "time": parts[1],
            "level": parts[2],
            "message": parts[3]
        }

        events.append(event)

print("Logstash: Parsed Events")
print(json.dumps(events, indent=2))

# Elasticsearch-style indexing
index = {}

for i, event in enumerate(events, start=1):
    index[i] = event

print("\nElasticsearch: Indexed", len(index), "events")

# Search ERROR events
print("\nSearch Results for ERROR:")

for event in index.values():
    if event["level"] == "ERROR":
        print(event)

# Kibana-style aggregation
counts = Counter(
    event["level"] for event in index.values()
)

print("\nKibana: Log Level Summary")

for level, count in counts.items():
    print(level, ":", count)
